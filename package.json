{
  "name": "gotham-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "node server/index.mjs",
    "test:fleet": "node scripts/check-fleet.mjs",
    "test:reports": "node scripts/check-business.mjs",
    "test:scene": "node scripts/check-scene-navigation.mjs",
    "test:scene:browser": "node scripts/check-scene.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5180",
    "dev:api": "node server/index.mjs",
    "test": "node --test server/tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
